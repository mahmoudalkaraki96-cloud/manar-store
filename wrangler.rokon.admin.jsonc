{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rokon-store-admin",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rokon-store-db",
      "database_id": "a5c50923-c7ec-4ede-95b3-d19b93914902",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rokon-store-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_SURFACE": "admin",
    "STORE_KEY": "rokon"
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  }
}
